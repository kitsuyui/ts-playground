{
  "name": "@kitsuyui/ts-playground",
  "private": true,
  "version": "0.1.11",
  "license": "MIT",
  "author": "Yui Kitsu <kitsuyui@kitsuyui.com>",
  "description": "A playground for TypeScript",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "dev": "bun run --parallel --workspaces dev",
    "format": "biome check --write ./",
    "lint": "biome check ./",
    "check-module-isolation": "find packages -type d -name src -print -exec bunx ts-module-isolation -- {} +",
    "test": "vitest run --coverage",
    "validate": "bun run --workspaces validate",
    "typecheck": "tsc --strict -p tsconfig.json --noEmit --skipLibCheck --downlevelIteration",
    "typedoc": "typedoc --treatValidationWarningsAsErrors --treatWarningsAsErrors",
    "typedoc:server": "python3 -m http.server --directory build/typedocs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@swc/core": "^1.15.43",
    "@vitest/coverage-v8": "4.1.12",
    "ts-module-isolation": "^1.0.2",
    "tsdown": "^0.20.3",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "validate-package-exports": "^0.18.0",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "tar": "7.5.21",
    "brace-expansion": "5.0.12",
    "markdown-it": "14.3.3",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2",
    "undici": "6.29.1",
    "http-cache-semantics": "4.3.0",
    "ip-address": "10.7.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
